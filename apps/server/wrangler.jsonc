{
  "name": "datango-server-dev",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-11",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "vars": {
    "ALCHEMY_STAGE": "dev",
    "WEB_URL": "http://localhost:3001",
    "API_URL": "http://localhost:3000",
    "MAIN_URL": "http://localhost:3002",
    "WEB_DOMAIN": "localhost:3001",
    "API_DOMAIN": "localhost:3000",
    "MAIN_DOMAIN": "localhost:3002",
    "API_PATTERN": "v1",
    "AUTH_SECRET": "nCVV8CGYrm8qEhVWZXqUQxFmLJrXiaYf"
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS_KV",
      "id": "kv",
      "preview_id": "kv"
    }
  ],
  "hyperdrive": [
    {
      "binding": "DATABASE",
      "id": "",
      "localConnectionString":"postgres://postgres:postgres@localhost:5432/datango"
    }
  ]
}
