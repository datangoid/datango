{
  "name": "datango",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "hono": "^4.8.2",
      "@orpc/server": "^1.10.0",
      "@orpc/openapi": "^1.10.0",
      "@orpc/zod": "^1.10.0",
      "better-auth": "^1.3.28",
      "dotenv": "^17.2.2",
      "zod": "^4.1.11",
      "typescript": "^5.8.2",
      "tsdown": "^0.15.5",
      "alchemy": "^0.77.0",
      "@types/node": "^22.13.11",
      "@orpc/client": "^1.10.0",
      "drizzle-orm": "^0.44.2"
    }
  },
  "scripts": {
    "prepare": "husky",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "format:unsafe": "biome format --write --unsafe .",
    "check": "bun run lint && bun run format",
    "check-types": "turbo check-types",

    "deva": "alchemy dev --env-file .env.dev",

    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",

    "db:start": "turbo -F @datango/db db:start",
    "db:push": "turbo -F @datango/db db:push",
    "db:studio": "turbo -F @datango/db db:studio",
    "db:generate": "turbo -F @datango/db db:generate",
    "db:migrate": "turbo -F @datango/db db:migrate"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "@biomejs/biome": "2.3.4",
    "ultracite": "6.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "tsdown": "^0.15.5",
    "@types/node": "^22.13.11",
    "alchemy": "^0.77.0",
    "@cloudflare/workers-types": "^4.20250822.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  },
  "packageManager": "bun@1.3.2"
}
