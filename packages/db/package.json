{
  "name": "@datango/db",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "db:start": "docker-compose up -d",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.2",
    "@types/ws": "^8.18.1",
    "tsdown": "catalog:",
    "@datango/config": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/pg": "^8.15.6",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "zod": "catalog:"
  }
}
